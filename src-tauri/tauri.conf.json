{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASA Server Manager",
  "version": "0.1.1",
  "identifier": "com.asaservermanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ASA Server Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://media.forgecdn.net https://*.forgecdn.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "ARK: Survival Ascended dedicated server manager",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "clawdroppin",
    "copyright": "Copyright (c) 2026 clawdroppin – MIT License",
    "homepage": "https://github.com/clawdroppin/ARK-SurvivalAscended-ServerManager",
    "longDescription": "Desktop manager for ARK: Survival Ascended dedicated servers: install, configure, mods, RCON, backups, automation and one-click repair."
  }
}
